{% assign repo = include.repository %}

<div class="repo p-2 w-100">
  <a
    class="card hoverable h-100 text-decoration-none"
    href="https://github.com/{{ repo.slug }}"
    target="_blank"
    rel="external nofollow noopener noreferrer"
    style="color: var(--global-text-color);"
  >
    <div class="card-body text-left">
      <h5 class="card-title font-weight-bold">
        {{ repo.title }}
      </h5>

      <p class="card-text">
        {{ repo.description }}
      </p>

      <span
        class="small"
        style="color: var(--global-theme-color);"
      >
        View repository on GitHub →
      </span>
    </div>
  </a>
</div>
